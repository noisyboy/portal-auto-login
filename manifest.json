{
  "manifest_version": 3,
  "name": "Portal Auto-Login",
  "version": "1.0",
  "description": "Automatically authenticates against known captive portals.",
 "browser_specific_settings": {
    "gecko": {
      "id": "portal-auto-login@noisyboy.github.io",
      "update_url": "https://raw.githubusercontent.com/noisyboy/portal-auto-login/main/updates.json"
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "Portal Auto-Login"
  },
  "icons": {
    "16": "icon16.svg",
    "48": "icon48.svg",
    "128": "icon.svg"
  }
}
